# Copia este archivo a .env.local y completa con los valores de tu proyecto
# de Supabase (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role key: nunca la expongas al navegador ni la subas a git.
# Solo se usa en server actions (creación de usuarios, subida de archivos,
# URLs firmadas).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
